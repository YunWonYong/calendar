{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "name": "calendar frontend (local)",
            "request": "launch",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "frontend dev",
            "sourceMaps": true 
        },
        {
            "type": "chrome",
            "name": "calendar frontend (local) force",
            "request": "launch",
            "url": "http://localhost:3001",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "frontend dev force",
            "sourceMaps": true,
        },
        {
            "type": "node",
            "request": "launch",
            "name": "현재 Jest 파일 디버깅",
            "program": "${workspaceFolder}/node_modules/jest/bin/jest",
            "args": [
                "${file}",
                "--runInBand",
                "--no-cache",
                "--transform={\"^.+\\\\.(ts|tsx)$\":\"ts-jest\"}"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "windows": {
                "program": "${workspaceFolder}/node_modules/jest/bin/jest.js"
            }
        }
    ]
}